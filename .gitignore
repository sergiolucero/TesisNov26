# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/

# Generated data and run artifacts
out/
figs/
do_results/
*.npz
*.pt
*.pth
*.ckpt
*.pyz
*.zip
runs/*.pt

# LaTeX build products (keep .tex sources)
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.pdf
# Keep compiled write-ups readable on GitHub
!TEX/*.pdf

# Local scratch / duplicated packaging
Untitled.ipynb
sessions.txt
ziprun1/

# Runtime / local files
*.pid
*.log
app.log
app.pid
.env
*.key
*.pem
.DS_Store

# Secrets: never commit credentials. .ssh_pass is the pattern historically
# used with `sshpass -f .ssh_pass` (see NewPlan.md §6 — tailnet SSH + keys,
# never a stored password).
.ssh_pass
.ssh_pass*
*.pass
*.secret
secrets/
netrc
.netrc

# Stray artifacts
# A malformed `--save-model True` once wrote a 3.7 MB torch checkpoint to a
# file literally named True. Guard against repeat accidents.
/True
/False

# Seed-sweep runs (SCRIPTS/seed_sweep.py): keep the summary + per-run manifests
# (small, they are the record) and ignore models/figures/checkpoints.
runs/sweeps/**/*.pt
runs/sweeps/**/*.png
runs/sweeps/**/*.pdf
runs/sweeps/**/checkpoint.pt

# Tracked archive snapshots
!ZIPS/**/*.zip
